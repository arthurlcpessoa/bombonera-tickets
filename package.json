{
  "name": "bombonera-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Venda de ingressos com escolha de assento em 3D na La Bombonera — projeto de portfólio.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "model:optimize": "node scripts/optimize-model.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5"
  }
}
