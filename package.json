{
  "name": "bombonera-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Venda de ingressos com escolha de assento em 3D na La Bombonera — projeto de portfólio.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,yellow --kill-others-on-fail \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "model:optimize": "node scripts/optimize-model.mjs",
    "stands:probe": "node --no-deprecation scripts/probe-stands.mjs",
    "stands:calibrate": "node --no-deprecation scripts/probe-stands.mjs calibrate && prettier --write packages/shared/src/standCalibration.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "concurrently": "^10.0.7",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.8.3"
  }
}
