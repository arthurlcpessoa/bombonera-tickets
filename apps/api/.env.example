# Copie este arquivo para apps/api/.env (o .env nunca vai para o Git).
# Todas as variáveis são opcionais: sem o .env, a API usa os valores padrão abaixo.

# development | production | test. Em production, erros internos não mostram detalhes.
NODE_ENV=development

# Onde a API escuta. 127.0.0.1 = só este computador; 0.0.0.0 = toda a rede (hospedagem).
HOST=127.0.0.1
PORT=3000

# Sites que podem chamar a API pelo navegador (CORS), separados por vírgula.
# Em produção, o endereço do site (ex.: https://bombonera-tickets.vercel.app).
CORS_ORIGIN=http://localhost:5173

# Quanto a API escreve no log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Limite de requisições por IP por minuto: geral e só para criar reservas (mais rígido).
RATE_LIMIT_MAX=300
RATE_LIMIT_HOLDS_MAX=20
